__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
.env

# dados: pesados e/ou de terceiros — não versionar
data/raw/*
data/processed/*
!data/**/.gitkeep
!data/**/README.md

# saídas brutas de experimento
results/**/*.csv
results/**/*.npz
results/**/*.pt
!results/**/.gitkeep

# figuras finais SÃO versionadas
!results/figures/*.pdf
# e as do manuscrito vivem em paper/figuras/, que e onde o
# 10_figuras.py as escreve. Entraram em a68d2a2 por ausencia de
# regra, nao por estarem nesta lista; agora estao declaradas.
!paper/figuras/*.pdf
!results/figures/*.png
!findings/**

# latex
*.aux
*.log
*.out
*.bbl
*.blg
*.synctex.gz

# a copia de leitura em LaTeX e produto do 19_tex.py: reconstruida a cada
# ajuste do conversor, e ninguem le o diff dela. O MANUSCRITO.md FICA
# versionado -- o diff do texto consolidado tem valor -- e um teste recusa
# a versao comitada quando ela deixa de ser o que os rascunhos produzem.
paper/MANUSCRITO.tex
paper/MANUSCRITO.pdf

# clones e snapshots de outros trabalhos, que vivem em repos proprios
pgsg4-bayesian-gating/
*.zip

# agregados de experimento: nao versionar, como os .csv e .npz
results/**/*.json
